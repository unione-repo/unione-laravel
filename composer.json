{
    "name": "unione-repo/unione-laravel",
    "version": "2.3.0",
    "description": "UniOne Web API for Laravel: API client, mail transport, webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "unione",
        "laravel",
        "email",
        "mail",
        "webhook"
    ],
    "homepage": "https://github.com/unione-repo/unione-laravel",
    "require": {
        "php": ">=8.1",
        "unione-repo/unione-php-sdk": "^2.3.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/mail": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/mailer": "^6.2|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "symfony/messenger": "^6.2|^7.0"
    },
    "autoload": {
        "psr-4": {
            "UniOne\\Wrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UniOne\\Wrapper\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "UniOne\\Wrapper\\UniOneServiceProvider"
            ],
            "aliases": {
                "UniOne": "UniOne\\Wrapper\\Facades\\UniOne"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
